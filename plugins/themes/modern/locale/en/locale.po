msgid "plugins.themes.modern.name"
msgstr "Modern Theme"

msgid "plugins.themes.modern.description"
msgstr "A clean, modern child theme extending the Default theme with card-based article layouts, generous whitespace, and a configurable homepage layout."

msgid "plugins.themes.modern.option.homepageLayout.label"
msgstr "Homepage Layout"

msgid "plugins.themes.modern.option.homepageLayout.description"
msgstr "Choose whether the homepage displays a sidebar alongside the main content, or uses the full width of the content area."

msgid "plugins.themes.modern.option.homepageLayout.sidebar"
msgstr "Sidebar: Display main content alongside the journal sidebar."

msgid "plugins.themes.modern.option.homepageLayout.fullWidth"
msgstr "Full Width: Use the entire content area for homepage content, hiding the sidebar."
